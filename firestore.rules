rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasAppAccess(appId) {
      return signedIn()
        && (
          isAdmin()
          || appId in get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.allowedApps
        );
    }

    function ownsExisting() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function ownsIncoming() {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function validStandardRanking(ranking) {
      return ranking is map
        && ranking.keys().hasOnly(['rank', 'participantCount'])
        && (
          !('rank' in ranking)
          || (ranking.rank is int && ranking.rank > 0)
        )
        && (
          !('participantCount' in ranking)
          || (
            ranking.participantCount is int
            && ranking.participantCount > 0
            && 'rank' in ranking
          )
        )
        && (
          !('rank' in ranking)
          || !('participantCount' in ranking)
          || ranking.participantCount >= ranking.rank
        );
    }

    function validStatusRanking(ranking, sentinel) {
      return ranking is map
        && ranking.keys().hasOnly(['rank'])
        && ranking.rank == sentinel;
    }

    function validRankings(data) {
      return data.rankings is map
        && data.rankings.keys().hasOnly(['sex', 'overall', 'category'])
        && data.rankings.keys().hasAll(['sex', 'overall', 'category'])
        && (
          (
            data.resultStatus == 'ranked'
            && validStandardRanking(data.rankings.sex)
            && validStandardRanking(data.rankings.overall)
            && validStandardRanking(data.rankings.category)
            && !('statusComment' in data)
          )
          || (
            data.resultStatus == 'dnf'
            && validStatusRanking(data.rankings.sex, -1)
            && validStatusRanking(data.rankings.overall, -1)
            && validStatusRanking(data.rankings.category, -1)
          )
          || (
            data.resultStatus == 'dsq'
            && validStatusRanking(data.rankings.sex, -2)
            && validStatusRanking(data.rankings.overall, -2)
            && validStatusRanking(data.rankings.category, -2)
          )
          || (
            data.resultStatus == 'dns'
            && validStatusRanking(data.rankings.sex, -3)
            && validStatusRanking(data.rankings.overall, -3)
            && validStatusRanking(data.rankings.category, -3)
          )
        )
        && (
          !('statusComment' in data)
          || (
            data.resultStatus != 'ranked'
            && data.statusComment is string
            && data.statusComment.size() <= 1000
          )
        );
    }

    function validCalendarDate(date) {
      return date is map
        && date.keys().hasOnly(['year', 'month', 'day'])
        && date.keys().hasAll(['year', 'month', 'day'])
        && date.year is int
        && date.year >= 1900
        && date.year <= 2100
        && date.month is int
        && date.month >= 1
        && date.month <= 12
        && date.day is int
        && date.day >= 1
        && date.day <= 31;
    }

    function validTrack(track) {
      return track is map
        && track.keys().hasOnly([
          'fileName',
          'originalPointCount',
          'points'
        ])
        && track.keys().hasAll([
          'fileName',
          'originalPointCount',
          'points'
        ])
        && track.fileName is string
        && track.fileName.size() > 0
        && track.fileName.size() <= 200
        && track.originalPointCount is int
        && track.points is list
        && track.originalPointCount >= track.points.size()
        && track.points.size() >= 2
        && track.points.size() <= 500;
    }

    function validSportIdentity() {
      return (
          request.resource.data.activityDefinitionId == 'road-running__race'
          && request.resource.data.categoryKey == 'running'
          && request.resource.data.sportKey == 'road-running'
        )
        || (
          request.resource.data.activityDefinitionId == 'trail-running__race'
          && request.resource.data.categoryKey == 'running'
          && request.resource.data.sportKey == 'trail-running'
        )
        || (
          request.resource.data.activityDefinitionId == 'road-cycling__race'
          && request.resource.data.categoryKey == 'cycling'
          && request.resource.data.sportKey == 'road-cycling'
        )
        || (
          request.resource.data.activityDefinitionId == 'mountain-biking__race'
          && request.resource.data.categoryKey == 'cycling'
          && request.resource.data.sportKey == 'mountain-biking'
        )
        || (
          request.resource.data.activityDefinitionId == 'gravel-cycling__race'
          && request.resource.data.categoryKey == 'cycling'
          && request.resource.data.sportKey == 'gravel-cycling'
        )
        || (
          request.resource.data.activityDefinitionId
            == 'open-water-swimming__race'
          && request.resource.data.categoryKey == 'swimming'
          && request.resource.data.sportKey == 'open-water-swimming'
        )
        || (
          request.resource.data.activityDefinitionId
            == 'ski-mountaineering__race'
          && request.resource.data.categoryKey == 'winter-sports'
          && request.resource.data.sportKey == 'ski-mountaineering'
        )
        || (
          request.resource.data.activityDefinitionId
            == 'cross-country-skiing-skating__race'
          && request.resource.data.categoryKey == 'winter-sports'
          && request.resource.data.sportKey
            == 'cross-country-skiing-skating'
        )
        || (
          request.resource.data.activityDefinitionId
            == 'cross-country-skiing-classic__race'
          && request.resource.data.categoryKey == 'winter-sports'
          && request.resource.data.sportKey
            == 'cross-country-skiing-classic'
        );
    }

    function isSwimmingDefinition() {
      return request.resource.data.activityDefinitionId
        == 'open-water-swimming__race';
    }

    function validRaceData(data) {
      return data is map
        && data.keys().hasOnly([
          'distanceMeters',
          'elevationGainMeters',
          'durationSeconds',
          'resultStatus',
          'rankings',
          'statusComment'
        ])
        && data.keys().hasAll([
          'distanceMeters',
          'durationSeconds',
          'resultStatus',
          'rankings'
        ])
        && data.distanceMeters is int
        && data.distanceMeters > 0
        && data.durationSeconds is int
        && data.durationSeconds > 0
        && (
          (
            isSwimmingDefinition()
            && !('elevationGainMeters' in data)
          )
          || (
            !isSwimmingDefinition()
            && data.elevationGainMeters is int
            && data.elevationGainMeters >= 0
          )
        )
        && validRankings(data);
    }

    function validPerformance(performanceId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'ownerUid',
          'activityDefinitionId',
          'schemaVersion',
          'categoryKey',
          'sportKey',
          'activityTypeKey',
          'title',
          'status',
          'date',
          'data',
          'track',
          'notes',
          'tags',
          'searchKeywords',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'ownerUid',
          'activityDefinitionId',
          'schemaVersion',
          'categoryKey',
          'sportKey',
          'activityTypeKey',
          'title',
          'status',
          'date',
          'data',
          'tags',
          'searchKeywords',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == performanceId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.activityTypeKey == 'race'
        && request.resource.data.status == 'completed'
        && validSportIdentity()
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 120
        && validCalendarDate(request.resource.data.date)
        && validRaceData(request.resource.data.data)
        && (
          !('track' in request.resource.data)
          || validTrack(request.resource.data.track)
        )
        && request.resource.data.tags is list
        && request.resource.data.searchKeywords is list
        && (
          !('notes' in request.resource.data)
          || (
            request.resource.data.notes is string
            && request.resource.data.notes.size() <= 1500
          )
        );
    }

    function isValidInitialProfile(uid) {
      return signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'allowedApps',
          'createdAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.allowedApps is list
        && request.resource.data.allowedApps.size() == 0
        && request.resource.data.createdAt == request.time;
    }

    match /admins/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() || isValidInitialProfile(uid);
      allow update, delete: if isAdmin();
    }

    match /apps/athletic-performance {
      allow read: if hasAppAccess('athletic-performance');
      allow create, update, delete: if isAdmin();

      match /activityDefinitions/{definitionId} {
        allow read: if hasAppAccess('athletic-performance');
        allow create, update, delete: if isAdmin();
      }

      match /performances/{performanceId} {
        allow read, delete:
          if hasAppAccess('athletic-performance') && ownsExisting();
        allow create:
          if hasAppAccess('athletic-performance')
          && ownsIncoming()
          && validPerformance(performanceId);
        allow update:
          if hasAppAccess('athletic-performance')
          && ownsExisting()
          && ownsIncoming()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && validPerformance(performanceId);
      }
    }
  }
}
