[debug] [2026-07-24T22:27:41.640Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/webappalex/rulesets {"name":"projects/webappalex/rulesets/7d3ced8a-ee45-458a-a8f6-c8d6c6dc4377","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isAdmin() {\n      return signedIn()\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n    }\n\n    function hasAppAccess(appId) {\n      return signedIn()\n        && (\n          isAdmin()\n          || appId in get(\n            /databases/$(database)/documents/users/$(request.auth.uid)\n          ).data.allowedApps\n        );\n    }\n\n    function ownsExisting() {\n      return signedIn() && resource.data.ownerUid == request.auth.uid;\n    }\n\n    function ownsIncoming() {\n      return signedIn() && request.resource.data.ownerUid == request.auth.uid;\n    }\n\n    function validStandardRanking(ranking) {\n      let rank = ranking.get('rank', 0);\n      let participantCount = ranking.get('participantCount', 0);\n\n      return ranking is map\n        && ranking.keys().hasOnly(['rank', 'participantCount'])\n        && (\n          ranking.keys().size() == 0\n          || (\n            rank is int\n            && rank > 0\n            && participantCount is int\n            && (\n              !ranking.keys().hasAny(['participantCount'])\n              || (\n                participantCount > 0\n                && participantCount - rank >= 0\n              )\n            )\n          )\n        );\n    }\n\n    function validStatusRanking(ranking, sentinel) {\n      return ranking is map\n        && ranking.keys().hasOnly(['rank'])\n        && ranking.rank == sentinel;\n    }\n\n    function validRankings(data) {\n      return data.rankings is map\n        && data.rankings.keys().hasOnly(['sex', 'overall', 'category'])\n        && (\n          (\n            data.resultStatus == 'ranked'\n            && (\n              !('sex' in data.rankings)\n              || validStandardRanking(data.rankings.sex)\n            )\n            && (\n              !('overall' in data.rankings)\n              || validStandardRanking(data.rankings.overall)\n            )\n            && (\n              !('category' in data.rankings)\n              || validStandardRanking(data.rankings.category)\n            )\n            && !('statusComment' in data)\n          )\n          || (\n            data.resultStatus == 'dnf'\n            && (\n              !('sex' in data.rankings)\n              || validStatusRanking(data.rankings.sex, -1)\n            )\n            && (\n              !('overall' in data.rankings)\n              || validStatusRanking(data.rankings.overall, -1)\n            )\n            && (\n              !('category' in data.rankings)\n              || validStatusRanking(data.rankings.category, -1)\n            )\n          )\n          || (\n            data.resultStatus == 'dsq'\n            && (\n              !('sex' in data.rankings)\n              || validStatusRanking(data.rankings.sex, -2)\n            )\n            && (\n              !('overall' in data.rankings)\n              || validStatusRanking(data.rankings.overall, -2)\n            )\n            && (\n              !('category' in data.rankings)\n              || validStatusRanking(data.rankings.category, -2)\n            )\n          )\n          || (\n            data.resultStatus == 'dns'\n            && (\n              !('sex' in data.rankings)\n              || validStatusRanking(data.rankings.sex, -3)\n            )\n            && (\n              !('overall' in data.rankings)\n              || validStatusRanking(data.rankings.overall, -3)\n            )\n            && (\n              !('category' in data.rankings)\n              || validStatusRanking(data.rankings.category, -3)\n            )\n          )\n        )\n        && (\n          !('statusComment' in data)\n          || (\n            data.resultStatus != 'ranked'\n            && data.statusComment is string\n            && data.statusComment.size() <= 1000\n          )\n        );\n    }\n\n    function validCalendarDate(date) {\n      return date is map\n        && date.keys().hasOnly(['year', 'month', 'day'])\n        && date.keys().hasAll(['year', 'month', 'day'])\n        && date.year is int\n        && date.year >= 1900\n        && date.year <= 2100\n        && date.month is int\n        && date.month >= 1\n        && date.month <= 12\n        && date.day is int\n        && date.day >= 1\n        && date.day <= 31;\n    }\n\n    function validTrack(track) {\n      return track is map\n        && track.keys().hasOnly([\n          'fileName',\n          'originalPointCount',\n          'points'\n        ])\n        && track.keys().hasAll([\n          'fileName',\n          'originalPointCount',\n          'points'\n        ])\n        && track.fileName is string\n        && track.fileName.size() > 0\n        && track.fileName.size() <= 200\n        && track.originalPointCount is int\n        && track.points is list\n        && track.originalPointCount >= track.points.size()\n        && track.points.size() >= 2\n        && track.points.size() <= 500;\n    }\n\n    function validSportIdentity() {\n      return (\n          request.resource.data.activityDefinitionId == 'road-running__race'\n          && request.resource.data.categoryKey == 'running'\n          && request.resource.data.sportKey == 'road-running'\n        )\n        || (\n          request.resource.data.activityDefinitionId == 'trail-running__race'\n          && request.resource.data.categoryKey == 'running'\n          && request.resource.data.sportKey == 'trail-running'\n        )\n        || (\n          request.resource.data.activityDefinitionId == 'road-cycling__race'\n          && request.resource.data.categoryKey == 'cycling'\n          && request.resource.data.sportKey == 'road-cycling'\n        )\n        || (\n          request.resource.data.activityDefinitionId == 'mountain-biking__race'\n          && request.resource.data.categoryKey == 'cycling'\n          && request.resource.data.sportKey == 'mountain-biking'\n        )\n        || (\n          request.resource.data.activityDefinitionId == 'gravel-cycling__race'\n          && request.resource.data.categoryKey == 'cycling'\n          && request.resource.data.sportKey == 'gravel-cycling'\n        )\n        || (\n          request.resource.data.activityDefinitionId\n            == 'open-water-swimming__race'\n          && request.resource.data.categoryKey == 'swimming'\n          && request.resource.data.sportKey == 'open-water-swimming'\n        )\n        || (\n          request.resource.data.activityDefinitionId\n            == 'winter-trail__race'\n          && request.resource.data.categoryKey == 'winter-sports'\n          && request.resource.data.sportKey == 'winter-trail'\n        )\n        || (\n          request.resource.data.activityDefinitionId\n            == 'ski-mountaineering__race'\n          && request.resource.data.categoryKey == 'winter-sports'\n          && request.resource.data.sportKey == 'ski-mountaineering'\n        )\n        || (\n          request.resource.data.activityDefinitionId\n            == 'cross-country-skiing-skating__race'\n          && request.resource.data.categoryKey == 'winter-sports'\n          && request.resource.data.sportKey\n            == 'cross-country-skiing-skating'\n        )\n        || (\n          request.resource.data.activityDefinitionId\n            == 'cross-country-skiing-classic__race'\n          && request.resource.data.categoryKey == 'winter-sports'\n          && request.resource.data.sportKey\n            == 'cross-country-skiing-classic'\n        )\n        || (\n          request.resource.data.activityDefinitionId == 'triathlon__race'\n          && request.resource.data.categoryKey == 'multisport'\n          && request.resource.data.sportKey == 'triathlon'\n        );\n    }\n\n    function isTriathlonDefinition() {\n      return request.resource.data.activityDefinitionId\n        == 'triathlon__race';\n    }\n\n    function isSwimmingDefinition() {\n      return request.resource.data.activityDefinitionId\n        == 'open-water-swimming__race';\n    }\n\n    function validRaceData(data) {\n      return data is map\n        && data.keys().hasOnly([\n          'distanceMeters',\n          'elevationGainMeters',\n          'durationSeconds',\n          'resultStatus',\n          'rankings',\n          'statusComment'\n        ])\n        && data.keys().hasAll([\n          'resultStatus',\n          'rankings'\n        ])\n        && (\n          !('distanceMeters' in data)\n          || (\n            data.distanceMeters is int\n            && data.distanceMeters > 0\n          )\n        )\n        && (\n          !('durationSeconds' in data)\n          || (\n            data.durationSeconds is int\n            && data.durationSeconds > 0\n          )\n        )\n        && (\n          data.resultStatus == 'ranked'\n          || !('durationSeconds' in data)\n        )\n        && (\n          (\n            isSwimmingDefinition()\n            && !('elevationGainMeters' in data)\n          )\n          || (\n            !isSwimmingDefinition()\n            && (\n              !('elevationGainMeters' in data)\n              || (\n                data.elevationGainMeters is int\n                && data.elevationGainMeters >= 0\n              )\n            )\n          )\n        )\n        && validRankings(data);\n    }\n\n    function validTriathlonDiscipline(data, allowsElevation) {\n      return data is map\n        && data.keys().hasOnly([\n          'distanceMeters',\n          'elevationGainMeters',\n          'durationSeconds',\n          'track'\n        ])\n        && (\n          !('distanceMeters' in data)\n          || (\n            data.distanceMeters is int\n            && data.distanceMeters > 0\n          )\n        )\n        && (\n          !('durationSeconds' in data)\n          || (\n            data.durationSeconds is int\n            && data.durationSeconds > 0\n          )\n        )\n        && (\n          (\n            !allowsElevation\n            && !('elevationGainMeters' in data)\n          )\n          || (\n            allowsElevation\n            && (\n              !('elevationGainMeters' in data)\n              || (\n                data.elevationGainMeters is int\n                && data.elevationGainMeters >= 0\n              )\n            )\n          )\n        )\n        && (\n          !('track' in data)\n          || validTrack(data.track)\n        );\n    }\n\n    function validTriathlonData(data) {\n      let swimmingTime =\n        data.disciplines.swimming.get('durationSeconds', 0);\n      let cyclingTime =\n        data.disciplines.cycling.get('durationSeconds', 0);\n      let runningTime =\n        data.disciplines.running.get('durationSeconds', 0);\n      let t1Time = data.transitions.get('t1DurationSeconds', 0);\n      let t2Time = data.transitions.get('t2DurationSeconds', 0);\n      let calculatedTotal =\n        swimmingTime + t1Time + cyclingTime + t2Time + runningTime;\n\n      return data is map\n        && data.keys().hasOnly([\n          'disciplines',\n          'transitions',\n          'totalDurationSeconds',\n          'resultStatus',\n          'rankings',\n          'statusComment'\n        ])\n        && data.keys().hasAll([\n          'disciplines',\n          'transitions',\n          'resultStatus',\n          'rankings'\n        ])\n        && data.disciplines is map\n        && data.disciplines.keys().hasOnly([\n          'swimming',\n          'cycling',\n          'running'\n        ])\n        && data.disciplines.keys().hasAll([\n          'swimming',\n          'cycling',\n          'running'\n        ])\n        && validTriathlonDiscipline(\n          data.disciplines.swimming,\n          false\n        )\n        && validTriathlonDiscipline(\n          data.disciplines.cycling,\n          true\n        )\n        && validTriathlonDiscipline(\n          data.disciplines.running,\n          true\n        )\n        && data.transitions is map\n        && data.transitions.keys().hasOnly([\n          't1DurationSeconds',\n          't2DurationSeconds'\n        ])\n        && (\n          !('t1DurationSeconds' in data.transitions)\n          || (\n            data.transitions.t1DurationSeconds is int\n            && data.transitions.t1DurationSeconds > 0\n          )\n        )\n        && (\n          !('t2DurationSeconds' in data.transitions)\n          || (\n            data.transitions.t2DurationSeconds is int\n            && data.transitions.t2DurationSeconds > 0\n          )\n        )\n        && (\n          (\n            calculatedTotal == 0\n            && !('totalDurationSeconds' in data)\n          )\n          || (\n            calculatedTotal > 0\n            && data.totalDurationSeconds is int\n            && data.totalDurationSeconds == calculatedTotal\n          )\n        )\n        && (\n          data.resultStatus == 'ranked'\n          || (\n            calculatedTotal == 0\n            && !('totalDurationSeconds' in data)\n          )\n        )\n        && validRankings(data);\n    }\n\n    function validPerformance(performanceId) {\n      return request.resource.data.keys().hasOnly([\n          'id',\n          'ownerUid',\n          'activityDefinitionId',\n          'schemaVersion',\n          'categoryKey',\n          'sportKey',\n          'activityTypeKey',\n          'title',\n          'status',\n          'date',\n          'data',\n          'track',\n          'notes',\n          'tags',\n          'searchKeywords',\n          'createdAt',\n          'updatedAt'\n        ])\n        && request.resource.data.keys().hasAll([\n          'id',\n          'ownerUid',\n          'activityDefinitionId',\n          'schemaVersion',\n          'categoryKey',\n          'sportKey',\n          'activityTypeKey',\n          'title',\n          'status',\n          'date',\n          'data',\n          'tags',\n          'searchKeywords',\n          'createdAt',\n          'updatedAt'\n        ])\n        && request.resource.data.id == performanceId\n        && request.resource.data.schemaVersion == 1\n        && request.resource.data.activityTypeKey == 'race'\n        && request.resource.data.status == 'completed'\n        && validSportIdentity()\n        && request.resource.data.title is string\n        && request.resource.data.title.size() >= 2\n        && request.resource.data.title.size() <= 120\n        && validCalendarDate(request.resource.data.date)\n        && (\n          (\n            isTriathlonDefinition()\n            && validTriathlonData(request.resource.data.data)\n            && !('track' in request.resource.data)\n          )\n          || (\n            !isTriathlonDefinition()\n            && validRaceData(request.resource.data.data)\n          )\n        )\n        && (\n          !('track' in request.resource.data)\n          || validTrack(request.resource.data.track)\n        )\n        && request.resource.data.tags is list\n        && request.resource.data.searchKeywords is list\n        && (\n          !('notes' in request.resource.data)\n          || (\n            request.resource.data.notes is string\n            && request.resource.data.notes.size() <= 1500\n          )\n        );\n    }\n\n    function isValidInitialProfile(uid) {\n      return signedIn()\n        && uid == request.auth.uid\n        && request.resource.data.keys().hasOnly([\n          'email',\n          'displayName',\n          'allowedApps',\n          'createdAt'\n        ])\n        && request.resource.data.email == request.auth.token.email\n        && request.resource.data.displayName is string\n        && request.resource.data.allowedApps is list\n        && request.resource.data.allowedApps.size() == 0\n        && request.resource.data.createdAt == request.time;\n    }\n\n    match /admins/{uid} {\n      allow get: if signedIn() && uid == request.auth.uid;\n      allow list, create, update, delete: if false;\n    }\n\n    match /users/{uid} {\n      allow get: if signedIn() && (uid == request.auth.uid || isAdmin());\n      allow list: if isAdmin();\n      allow create: if isAdmin() || isValidInitialProfile(uid);\n      allow update, delete: if isAdmin();\n    }\n\n    match /apps/athletic-performance {\n      allow read: if hasAppAccess('athletic-performance');\n      allow create, update, delete: if isAdmin();\n\n      match /activityDefinitions/{definitionId} {\n        allow read: if hasAppAccess('athletic-performance');\n        allow create, update, delete: if isAdmin();\n      }\n\n      match /performances/{performanceId} {\n        allow read, delete:\n          if hasAppAccess('athletic-performance') && ownsExisting();\n        allow create:\n          if hasAppAccess('athletic-performance')\n          && ownsIncoming()\n          && validPerformance(performanceId);\n        allow update:\n          if hasAppAccess('athletic-performance')\n          && ownsExisting()\n          && ownsIncoming()\n          && request.resource.data.ownerUid == resource.data.ownerUid\n          && validPerformance(performanceId);\n      }\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-07-24T22:27:41.684703Z","metadata":{"services":["cloud.firestore"]}}
